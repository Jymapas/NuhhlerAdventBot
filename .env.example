# Telegram
BOT_TOKEN=
OWNER_IDS= # список через запятую, например: 111,222

# Database
DB_PATH=/app/data/advent.db

# Logging (files inside container; bind-mounted to ./logs on host)
BOT_LOG_PATH=/app/logs/bot.log
WORKER_LOG_PATH=/app/logs/worker.log
LOG_RETENTION_DAYS=14

# Timezone
TZ=Asia/Almaty
ASPNETCORE_ENVIRONMENT=Production
